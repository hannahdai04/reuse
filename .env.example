OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Required for real ALFWorld runs.
# Point this at the directory that contains json_2.1.1/ and logic/.
ALFWORLD_DATA=

# Optional. If unset, the ALFWorld adapter can use configs/environments/alfworld_textworld_base.yaml.
ALFWORLD_CONFIG=

# Optional for ScienceWorld. Leave empty to use the package's bundled jar.
SCIENCEWORLD_JAR_PATH=
